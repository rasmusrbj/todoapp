# Copy to backend/.env for local development. Every variable is optional; the
# defaults in todoapp/config.py target a local PostgreSQL and a Next.js dev server.

TODOAPP_ENVIRONMENT=development
TODOAPP_LOG_LEVEL=INFO

TODOAPP_HOST=127.0.0.1
TODOAPP_PORT=8081

TODOAPP_DATABASE_URL=postgresql://postgres@localhost:5432/todoapp

# Comma-separated. Must list the web app's exact origin — a Connect browser client
# is always preflighted and a wildcard cannot carry credentials.
TODOAPP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used to build the links in verification and password-reset emails.
TODOAPP_WEB_BASE_URL=http://localhost:3000

# Turn on once the deployment serves HTTPS.
TODOAPP_SESSION_COOKIE_SECURE=false

# Argon2id cost. Leave at the defaults in production; lower only for tests.
# TODOAPP_ARGON2_TIME_COST=2
# TODOAPP_ARGON2_MEMORY_COST_KIB=19456
